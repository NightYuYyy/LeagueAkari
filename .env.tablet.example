# 浏览器访问路径为 /room/<TABLET_ROOM_CODE>。公网部署建议使用 12 位以上随机值。
TABLET_ROOM_CODE=replace-with-a-random-room-code

# 至少 16 个字符，仅配置在服务器与游戏电脑中，不要放进浏览器地址。
TABLET_PUBLISH_TOKEN=replace-with-a-long-random-secret

# 使用 Caddy/Nginx 时保持 127.0.0.1；直接通过 IP 访问时才改为 0.0.0.0。
TABLET_BIND=127.0.0.1
TABLET_PORT=4174
TABLET_IMAGE=league-akari-tablet:latest
